      "focus": {
        "default": "mdi:image-filter-center-focus"
      },
      "keystone": {
        "default": "mdi:perspective-more"
      },
      "picture_brightness": {
        "default": "mdi:brightness-5"
      },
      "picture_contrast": {
        "default": "mdi:contrast-box"
      },
      "picture_saturation": {
        "default": "mdi:palette"
      },
      "picture_sharpness": {
        "default": "mdi:image-filter-hdr"
      },
      "white_balance_red": {
        "default": "mdi:alpha-r-circle-outline"
      },
      "white_balance_green": {
        "default": "mdi:alpha-g-circle-outline"
      },
      "white_balance_blue": {
        "default": "mdi:alpha-b-circle-outline"
