{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "选择要设置的投影仪。",
        "data": {
          "address": "投影仪"
        }
      },
      "pair": {
        "title": "与 {name} 配对",
        "description": "Home Assistant 将像手机应用一样，在投影仪上注册为遥控器。\n\n1. 确保投影仪已开启（正在投影或处于待机状态），并在蓝牙适配器或 ESPHome 蓝牙代理的范围内。\n2. 在手机应用中，确认 **Settings → Network → Restrict adding smartphones** 已关闭。\n3. 提交以进行配对。Home Assistant 将以“Home Assistant”的名称出现在 **Smartphones added** 中。配对可能需要一分钟。"
      },
      "reauth_confirm": {
        "title": "重新配对 {name}",
        "description": "投影仪不再接受 Home Assistant 的命令，例如它已从 **Smartphones added** 中移除或投影仪已被重置。请确保投影仪已开启且 **Restrict adding smartphones** 已关闭，然后提交以重新配对。"
      }
    },
    "error": {
      "device_not_found": "投影仪不在蓝牙范围内。请打开投影仪并将其靠近蓝牙适配器或代理。",
      "cannot_connect": "无法通过蓝牙与投影仪通信（{error}）。请关闭手机应用，确保投影仪已开启并靠近蓝牙适配器或代理，然后重试。详细信息请查看 Home Assistant 日志。",
      "pairing_failed": "投影仪未接受配对（{error}）。请确认“Restrict adding smartphones”已关闭，然后重试。"
    },
    "abort": {
